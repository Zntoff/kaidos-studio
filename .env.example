# Copy this file to .env and fill in the values. Never commit .env.

# --- AI provider ---
# Usually you choose it in Settings (provider, key, models and prices). These variables are the alternative.
# anthropic | openai | gemini | openrouter | mistral | deepseek | groq | ollama | custom  (see config/providers.json)
CLIPPER_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# anthropic (= with AI, using the chosen provider) | offline (heuristics to test the pipeline; nothing is approved)
CLIPPER_LLM=anthropic
# Anthropic models. Models for other providers are chosen in Settings.
CLIPPER_MODEL_FAST=claude-haiku-5-5
CLIPPER_MODEL_STANDARD=claude-sonnet-5-5
CLIPPER_MODEL_SUPERIOR=claude-opus-5-5

# --- Data (ignored in Docker: the container uses /data) ---
CLIPPER_DATA_DIR=./data
# SQLite inside CLIPPER_DATA_DIR by default. For Postgres:
# DATABASE_URL=postgresql+psycopg://clipper:clipper@localhost:5432/clipper

# --- Output ---
CLIPPER_LANGUAGES=en,es
CLIPPER_MAX_CLIPS=12
CLIPPER_CLIP_MIN_S=20
CLIPPER_CLIP_MAX_S=90
CLIPPER_PUBLISH_SLOTS=12:00,19:00

# --- Transcription (faster-whisper) ---
# CPU: small + int8. NVIDIA GPU: large-v3 + cuda + float16.
CLIPPER_WHISPER_MODEL=small
CLIPPER_WHISPER_DEVICE=cpu
CLIPPER_WHISPER_COMPUTE=int8

# --- Signals ---
# full (accurate) | keyframes (about 15 times faster, coarser) | off
CLIPPER_SCENE_MODE=full

# --- Audio ---
CLIPPER_TARGET_LUFS=-14
CLIPPER_TRUE_PEAK=-1

# --- On-screen text ---
CLIPPER_CAPTION_FONT=Inter Black
CLIPPER_TEXT_FONT=Inter
