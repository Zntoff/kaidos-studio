<Window x:Class="ClipperStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Kairos Studio" Width="1600" Height="980" MinWidth="360" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#000000">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#000000" />
        <StackPanel x:Name="Splash" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="24">
            <Path Data="M21 0H57L75 18V96H21Z M31 10V86H65V22.142L52.858 10Z M42 42H54V54H42Z M0 45H15V51H0Z M81 45H96V51H81Z"
                  Fill="#FAFAFA" Width="72" Height="72" Stretch="Uniform" Margin="0,0,0,24" />
            <TextBlock Text="Kairos Studio" Foreground="#FAFAFA" FontFamily="Segoe UI Variable" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock x:Name="Status" Text="Preparing FFmpeg and GPU…" Foreground="#8C8C8C" FontFamily="Segoe UI Variable" FontSize="13"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
